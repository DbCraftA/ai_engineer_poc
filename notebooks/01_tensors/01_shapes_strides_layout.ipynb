    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# Shapes, strides and layout\\n\",\n",
    "    \"\\n\",\n",
    "    \"## Question\\n\",\n",
    "    \"\\n\",\n",
    "    \"How do shape, stride, transpose, contiguous layout and shared storage explain how a tensor is interpreted in memory?\\n\",\n",
    "    \"\\n\",\n",
    "    \"## Hypothesis\\n\",\n",
    "    \"\\n\",\n",
    "    \"A transpose can often be represented as a view by changing strides, while `contiguous()` materializes a new memory layout when needed.\\n\",\n",
    "    \"\\n\",\n",
    "    \"## Experiment\\n\",\n",
    "    \"\\n\",\n",
    "    \"Create small tensors, inspect `shape`, `stride`, `is_contiguous()` and storage pointers.\\n\",\n",
    "    \"\\n\",\n",
    "    \"## Results\\n\",\n",
    "    \"\\n\",\n",
    "    \"To be filled after running the notebook.\\n\",\n",
    "    \"\\n\",\n",
    "    \"## Conclusion\\n\",\n",
    "    \"\\n\",\n",
    "    \"To be filled after comparing the observations with the hypothesis.\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"import torch\\n\",\n",
    "    \"\\n\",\n",
    "    \"x = torch.arange(2 * 3 * 4).reshape(2, 3, 4)\\n\",\n",
    "    \"print('shape:', x.shape)\\n\",\n",
    "    \"print('stride:', x.stride())\\n\",\n",
    "    \"print('is_contiguous:', x.is_contiguous())\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"y = x.transpose(1, 2)\\n\",\n",
    "    \"print('shape:', y.shape)\\n\",\n",
    "    \"print('stride:', y.stride())\\n\",\n",
    "    \"print('is_contiguous:', y.is_contiguous())\\n\",\n",
    "    \"print('shares storage:', y.storage().data_ptr() == x.storage().data_ptr())\\n\"\n",
    "   ]\n",
    "  }\n",
    " ],\n",
